# Copy to .env.local and fill in real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Web Push public key — same as VAPID_PUBLIC_KEY set on Edge Function secrets.
# Generate once with: node scripts/generate-vapid-keys.cjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional: hosts that bypass custom-domain rewriting (comma-separated).
# Defaults to localhost + 127.0.0.1 + favornoms.com + app.favornoms.com.
# NEXT_PUBLIC_APEX_HOSTS=

# Mapbox (address autocomplete + live tracking maps) - optional, degrades gracefully
NEXT_PUBLIC_MAPBOX_TOKEN=

# Origin of the merchant back office, where the marketing page's "Start 14 days
# free" CTAs point. Defaults to the local dev port (3004) when unset.
# NEXT_PUBLIC_MERCHANT_URL=https://merchant.favornoms.com
